# 실제 키는 .env 또는 환경변수에만 저장한다. .env는 커밋하지 않는다.
# 공식 YouTube 검색·메타데이터용. 키가 없어도 링크·음원 연결·데모는 사용 가능.
YOUTUBE_API_KEY=

# 선택 소스 분리. CPU에서는 오래 걸릴 수 있으므로 기본 비활성.
# CHORDAPP_ENABLE_DEMUCS=1

# 개인 전용 선택 기능. 두 설정이 모두 1일 때만 동작한다.
# 설치: pip install -r requirements-private.txt
# CHORDAPP_PRIVATE_MODE=1
# CHORDAPP_ENABLE_YTDLP=1

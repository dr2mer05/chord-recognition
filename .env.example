# 이 파일을 `.env`로 복사한 뒤 값을 채운다. `.env`는 커밋되지 않는다.

# 유튜브 검색용. Google Cloud Console → API 및 서비스 →
# 라이브러리에서 "YouTube Data API v3" 사용 설정 → 사용자 인증 정보 → API 키.
# 검색·메타데이터 조회만 쓰므로 공식 API 범위 안이다.
YOUTUBE_API_KEY=

# 유튜브 오디오 추출(yt-dlp) 활성화. 기본은 꺼짐.
# 파이프라인 1-8의 "유튜브 오디오 추출 방식의 이용약관 적합성 검토"가
# 끝나기 전에는 켜지 말 것. 켜는 판단의 책임은 운영자에게 있다.
# CHORDAPP_ENABLE_YTDLP=1
